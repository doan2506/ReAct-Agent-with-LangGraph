# Gmail OAuth (read-only). Download the OAuth client secrets from Google Cloud
# and point these at the files. token.json is created automatically on first run.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# To separate your traces from other application
LANGSMITH_PROJECT=react-agent

# The following depend on your selected configuration

## LLM choice:
# Default model is google_genai/gemini-3.5-flash-lite, so GOOGLE_API_KEY is required.
# Get one from Google AI Studio: https://aistudio.google.com/app/apikey
MODEL=google_genai/gemini-3.5-flash-lite
GOOGLE_API_KEY=...

# Only needed if you switch MODEL to one of these providers:
ANTHROPIC_API_KEY=...
FIREWORKS_API_KEY=...
OPENAI_API_KEY=...
